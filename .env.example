# local | test | polygon-fork | staging | production-readonly | production-controlled
EVENTCLEAR_MODE=local
# Use postgres outside unit tests and lightweight local UI development.
EVENTCLEAR_STORE=postgres
# 31337 locally; production must be 137.
CHAIN_ID=31337
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
DATABASE_URL=postgresql://eventclear:eventclear@postgres:5432/eventclear
REDIS_URL=redis://redis:6379/0
SOLVER_URL=http://solver:8001
ANVIL_RPC_URL=http://anvil:8545
# Comma-separated Polygon RPC endpoints; at least two in production.
POLYGON_RPC_URLS=
POLYGON_FORK_BLOCK=
CONTRACT_MANIFEST_PATH=config/contracts/local.json
# Reviewed Polymarket dependencies. Production deployment reads the manifest
# and rejects any mismatch.
PUSD_ADDRESS=0xC011a7E12a19f7B1f670d46F03B03f3342E82DFB
USDCE_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
CTF_ADDRESS=0x4D97DCd97eC945f40cF65F87097ACe5EA0476045
CTF_COLLATERAL_ADAPTER_ADDRESS=0xADa100874d00e3331D00F2007a9c336a65009718
NEG_RISK_COLLATERAL_ADAPTER_ADDRESS=0xAdA200001000ef00D07553cEE7006808F895c6F1
# Deployed protocol contracts; populated by local deployment.
VAULT_ADDRESS=0x0000000000000000000000000000000000001000
CLAIMS_ADDRESS=0x0000000000000000000000000000000000001001
FUNDING_POOL_ADDRESS=0x0000000000000000000000000000000000001002
COLLATERAL_TOKEN_ADDRESS=0x0000000000000000000000000000000000001005
STANDARD_CTF_ADAPTER_ADDRESS=0x0000000000000000000000000000000000001006
RELATIONSHIP_REGISTRY_ADDRESS=0x0000000000000000000000000000000000001003
TREASURY_ADDRESS=0x0000000000000000000000000000000000001004
# Local-only signer. Use AWS KMS/remote signer configuration in production.
RISK_SIGNER_PRIVATE_KEY=0x59c6995e998f97a5a0044976f0945389dc9e86dae88c7a8412f4603b6b78690d
RISK_SIGNER_BACKEND=local
RISK_SIGNER_ADDRESS=
RISK_SIGNER_KMS_KEY_ID=
RISK_SIGNER_KMS_REGION=
# Production contract control. Every role must be a reviewed Polygon multisig.
GOVERNANCE_MULTISIG=
TREASURY_MULTISIG=
RELATIONSHIP_REVIEWER_MULTISIG=
EMERGENCY_SUSPENDER_MULTISIG=
EMERGENCY_PAUSER_MULTISIG=
RISK_ADMIN_MULTISIG=
LP_ADMIN_MULTISIG=
MAINNET_DEPOSIT_CAP_ATOMIC=
MAINNET_PER_BUNDLE_CAP_ATOMIC=
ADMIN_API_TOKEN=local-admin
SIWE_SESSION_SECRET=change-me-local-only
SIWE_DOMAIN=eventclear.local
SIWE_URI=http://eventclear.local
SENTRY_DSN=
QUOTE_LIFETIME_SECONDS=300
ADVANCE_RATIO_BPS=9500
ORIGINATION_FEE_BPS=50
MARKET_FRESHNESS_SECONDS=30
INDEXER_CONFIRMATIONS=64
INDEXER_START_BLOCK=0
# Production safety gates. All must be literal "true".
ENABLE_MAINNET_EXECUTION=false
PRODUCTION_MANIFEST_APPROVED=false
CONTRACTS_DEPLOYED=false
CONTRACTS_VERIFIED=false
RISK_SIGNER_CONFIGURED=false
ADMIN_MULTISIG_CONFIGURED=false
TREASURY_MULTISIG_CONFIGURED=false
RPC_FAILOVER_CONFIGURED=false
MONITORING_CONFIGURED=false
ALLOWLIST_CONFIGURED=false
CAPS_CONFIGURED=false
INDEPENDENT_SECURITY_REVIEW_RECORDED=false
LEGAL_RELEASE_APPROVED=false
