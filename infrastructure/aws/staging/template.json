ntClear/Staging\", \"ReconciliationErrors\", \"Stack\", \"${AWS::StackName}\"]], \"period\": 60, \"stat\": \"Sum\"}}, {\"type\": \"metric\", \"width\": 8, \"height\": 6, \"properties\": {\"title\": \"KMS signing errors\", \"region\": \"${AWS::Region}\", \"metrics\": [[\"EventClear/Staging\", \"SignerError\", \"Stack\", \"${AWS::StackName}\"]], \"period\": 60, \"stat\": \"Sum\"}}, {\"type\": \"metric\", \"width\": 8, \"height\": 6, \"properties\": {\"title\": \"Active bundles\", \"region\": \"${AWS::Region}\", \"metrics\": [[\"EventClear/Staging\", \"ActiveBundles\", \"Stack\", \"${AWS::StackName}\"]], \"period\": 60, \"stat\": \"Maximum\"}}, {\"type\": \"metric\", \"width\": 8, \"height\": 6, \"properties\": {\"title\": \"Pool utilization\", \"region\": \"${AWS::Region}\", \"metrics\": [[\"EventClear/Staging\", \"PoolUtilization\", \"Stack\", \"${AWS::StackName}\"]], \"period\": 60, \"stat\": \"Maximum\"}}, {\"type\": \"metric\", \"width\": 8, \"height\": 6, \"properties\": {\"title\": \"Settlement errors\", \"region\": \"${AWS::Region}\", \"metrics\": [[\"EventClear/Staging\", \"SettlementFailures\", \"Stack\", \"${AWS::StackName}\"]], \"period\": 60, \"stat\": \"Sum\"}}, {\"type\": \"metric\", \"width\": 8, \"height\": 6, \"properties\": {\"title\": \"Shortfalls\", \"region\": \"${AWS::Region}\", \"metrics\": [[\"EventClear/Staging\", \"Shortfalls\", \"Stack\", \"${AWS::StackName}\"]], \"period\": 60, \"stat\": \"Sum\"}}, {\"type\": \"metric\", \"width\": 8, \"height\": 6, \"properties\": {\"title\": \"Task errors\", \"region\": \"${AWS::Region}\", \"metrics\": [[\"EventClear/Staging\", \"TaskCrash\", \"Stack\", \"${AWS::StackName}\"]], \"period\": 60, \"stat\": \"Sum\"}}, {\"type\": \"metric\", \"width\": 8, \"height\": 6, \"properties\": {\"title\": \"ALB target health\", \"region\": \"${AWS::Region}\", \"metrics\": [[\"AWS/ApplicationELB\", \"HealthyHostCount\", \"LoadBalancer\", \"${Alb.LoadBalancerFullName}\", \"TargetGroup\", \"${ApiTarget.TargetGroupFullName}\"]], \"period\": 60, \"stat\": \"Average\"}}, {\"type\": \"metric\", \"width\": 8, \"height\": 6, \"properties\": {\"title\": \"RDS memory\", \"region\": \"${AWS::Region}\", \"metrics\": [[\"AWS/RDS\", \"FreeableMemory\", \"DBInstanceIdentifier\", \"${Database}\"]], \"period\": 60, \"stat\": \"Average\"}}, {\"type\": \"metric\", \"width\": 8, \"height\": 6, \"properties\": {\"title\": \"Redis memory\", \"region\": \"${AWS::Region}\", \"metrics\": [[\"AWS/ElastiCache\", \"DatabaseMemoryUsagePercentage\", \"CacheClusterId\", \"${Redis}-001\"]], \"period\": 60, \"stat\": \"Average\"}}, {\"type\": \"metric\", \"width\": 8, \"height\": 6, \"properties\": {\"title\": \"api ECS CPU/memory\", \"region\": \"${AWS::Region}\", \"metrics\": [[\"AWS/ECS\", \"CPUUtilization\", \"ClusterName\", \"${Cluster}\", \"ServiceName\", \"${AWS::StackName}-api\"], [\".\", \"MemoryUtilization\", \".\", \".\", \".\", \".\"]], \"period\": 60, \"stat\": \"Average\"}}, {\"type\": \"metric\", \"width\": 8, \"height\": 6, \"properties\": {\"title\": \"web ECS CPU/memory\", \"region\": \"${AWS::Region}\", \"metrics\": [[\"AWS/ECS\", \"CPUUtilization\", \"ClusterName\", \"${Cluster}\", \"ServiceName\", \"${AWS::StackName}-web\"], [\".\", \"MemoryUtilization\", \".\", \".\", \".\", \".\"]], \"period\": 60, \"stat\": \"Average\"}}, {\"type\": \"metric\", \"width\": 8, \"height\": 6, \"properties\": {\"title\": \"solver ECS CPU/memory\", \"region\": \"${AWS::Region}\", \"metrics\": [[\"AWS/ECS\", \"CPUUtilization\", \"ClusterName\", \"${Cluster}\", \"ServiceName\", \"${AWS::StackName}-solver\"], [\".\", \"MemoryUtilization\", \".\", \".\", \".\", \".\"]], \"period\": 60, \"stat\": \"Average\"}}, {\"type\": \"metric\", \"width\": 8, \"height\": 6, \"properties\": {\"title\": \"indexer ECS CPU/memory\", \"region\": \"${AWS::Region}\", \"metrics\": [[\"AWS/ECS\", \"CPUUtilization\", \"ClusterName\", \"${Cluster}\", \"ServiceName\", \"${AWS::StackName}-indexer\"], [\".\", \"MemoryUtilization\", \".\", \