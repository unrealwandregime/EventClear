{
 "AWSTemplateFormatVersion": "2010-09-09",
 "Description": "Controlled EventClear test-asset staging infrastructure. Services bootstrap separately after migration and contract verification.",
 "Parameters": {
  "DomainName": {
   "Type": "String",
   "AllowedPattern": "[a-z0-9][a-z0-9.-]+"
  },
  "HostedZoneId": {
   "Type": "AWS::Route53::HostedZone::Id"
  },
  "AlertEmail": {
   "Type": "String",
   "AllowedPattern": "[^@ ]+@[^@ ]+\\.[^@ ]+"
  },
  "BudgetUsd": {
   "Type": "Number",
   "MinValue": 1
  },
  "AllowProvision": {
   "Type": "String",
   "AllowedValues": [
    "true"
   ]
  },
  "DbInstanceClass": {
   "Type": "String",
   "Default": "db.t4g.micro",
   "AllowedValues": [
    "db.t4g.micro",
    "db.t4g.small"
   ]
  },
  "RedisNodeType": {
   "Type": "String",
   "Default": "cache.t4g.micro",
   "AllowedValues": [
    "cache.t4g.micro",
    "cache.t4g.small"
   ]
  }
 },
 "Resources": {
  "Vpc": {
   "Type": "AWS::EC2::VPC",
   "Properties": {
    "CidrBlock": "10.64.0.0/16",
    "EnableDnsHostnames": true,
    "EnableDnsSupport": true,
    "Tags": [
     {
      "Key": "Project",
      "Value": "EventClearStaging"
     },
     {
      "Key": "ProvisioningEnabled",
      "Value": {
       "Ref": "AllowProvision"
      }
     }
    ]
   }
  },
  "Gateway": {
   "Type": "AWS::EC2::InternetGateway",
   "Properties": {}
  },
  "GatewayAttachment": {
   "Type": "AWS::EC2::VPCGatewayAttachment",
   "Properties": {
    "VpcId": {
     "Ref": "Vpc"
    },
    "InternetGatewayId": {
     "Ref": "Gateway"
    }
   }
  },
  "PublicRoutes": {
   "Type": "AWS::EC2::RouteTable",
   "Properties": {
    "VpcId": {
     "Ref": "Vpc"
    }
   }
  },
  "InternetRoute": {
   "Type": "AWS::EC2::Route",
   "Properties": {
    "RouteTableId": {
     "Ref": "PublicRoutes"
    },
    "DestinationCidrBlock": "0.0.0.0/0",
    "GatewayId": {
     "Ref": "Gateway"
    }
   },
   "DependsOn": "GatewayAttachment"
  },
  "PublicSubnet0": {
   "Type": "AWS::EC2::Subnet",
   "Properties": {
    "VpcId": {
     "Ref": "Vpc"
    },
    "CidrBlock": "10.64.0.0/24",
    "AvailabilityZone": {
     "Fn::Select": [
      0,
      {
       "Fn::GetAZs": ""
      }
     ]
    },
    "MapPublicIpOnLaunch": false
   }
  },
  "PublicSubnet0Route": {
   "Type": "AWS::EC2::SubnetRouteTableAssociation",
   "Properties": {
    "SubnetId": {
     "Ref": "PublicSubnet0"
    },
    "RouteTableId": {
     "Ref": "PublicRoutes"
    }
   }
  },
  "PrivateSubnet0": {
   "Type": "AWS::EC2::Subnet",
   "Properties": {
    "VpcId": {
     "Ref": "Vpc"
    },
    "CidrBlock": "10.64.10.0/24",
    "AvailabilityZone": {
     "Fn::Select": [
      0,
      {
       "Fn::GetAZs": ""
      }
     ]
    },
    "MapPublicIpOnLaunch": false
   }
  },
  "PublicSubnet1": {
   "Type": "AWS::EC2::Subnet",
   "Properties": {
    "VpcId": {
     "Ref": "Vpc"
    },
    "CidrBlock": "10.64.1.0/24",
    "AvailabilityZone": {
     "Fn::Select": [
      1,
      {
       "Fn::GetAZs": ""
      }
     ]
    },
    "MapPublicIpOnLaunch": false
   }
  },
  "PublicSubnet1Route": {
   "Type": "AWS::EC2::SubnetRouteTableAssociation",
   "Properties": {
    "SubnetId": {
     "Ref": "PublicSubnet1"
    },
    "RouteTableId": {
     "Ref": "PublicRoutes"
    }
   }
  },
  "PrivateSubnet1": {
   "Type": "AWS::EC2::Subnet",
   "Properties": {
    "VpcId": {
     "Ref": "Vpc"
    },
    "CidrBlock": "10.64.11.0/24",
    "AvailabilityZone": {
     "Fn::Select": [
      1,
      {
       "Fn::GetAZs": ""
      }
     ]
    },
    "MapPublicIpOnLaunch": false
   }
  },
  "AlbSG": {
   "Type": "AWS::EC2::SecurityGroup",
   "Properties": {
    "GroupDescription": "EventClear Alb only",
    "VpcId": {
     "Ref": "Vpc"
    },
    "SecurityGroupEgress": [
     {
      "IpProtocol": "-1",
      "CidrIp": "0.0.0.0/0",
      "Description": "Outbound TLS and AWS services; no public inbound"
     }
    ]
   }
  },
  "WebSG": {
   "Type": "AWS::EC2::SecurityGroup",
   "Properties": {
    "GroupDescription": "EventClear Web only",
    "VpcId": {
     "Ref": "Vpc"
    },
    "SecurityGroupEgress": [
     {
      "IpProtocol": "-1",
      "CidrIp": "0.0.0.0/0",
      "Description": "Outbound TLS and AWS services; no public inbound"
     }
    ]
   }
  },
  "ApiSG": {
   "Type": "AWS::EC2::SecurityGroup",
   "Properties": {
    "GroupDescription": "EventClear Api only",
    "VpcId": {
     "Ref": "Vpc"
    },
    "SecurityGroupEgress": [
     {
      "IpProtocol": "-1",
      "CidrIp": "0.0.0.0/0",
      "Description": "Outbound TLS and AWS services; no public inbound"
     }
    ]
   }
  },
  "SolverSG": {
   "Type": "AWS::EC2::SecurityGroup",
   "Properties": {
    "GroupDescription": "EventClear Solver only",
    "VpcId": {
     "Ref": "Vpc"
    },
    "SecurityGroupEgress": [
     {
      "IpProtocol": "-1",
      "CidrIp": "0.0.0.0/0",
      "Description": "Outbound TLS and AWS services; no public inbound"
     }
    ]
   }
  },
  "IndexerSG": {
   "Type": "AWS::EC2::SecurityGroup",
   "Properties": {
    "GroupDescription": "EventClear Indexer only",
    "VpcId": {
     "Ref": "Vpc"
    },
    "SecurityGroupEgress": [
     {
      "IpProtocol": "-1",
      "CidrIp": "0.0.0.0/0",
      "Description": "Outbound TLS and AWS services; no public inbound"
     }
    ]
   }
  },
  "MigrationSG": {
   "Type": "AWS::EC2::SecurityGroup",
   "Properties": {
    "GroupDescription": "EventClear Migration only",
    "VpcId": {
     "Ref": "Vpc"
    },
    "SecurityGroupEgress": [
     {
      "IpProtocol": "-1",
      "CidrIp": "0.0.0.0/0",
      "Description": "Outbound TLS and AWS services; no public inbound"
     }
    ]
   }
  },
  "DatabaseSG": {
   "Type": "AWS::EC2::SecurityGroup",
   "Properties": {
    "GroupDescription": "EventClear Database only",
    "VpcId": {
     "Ref": "Vpc"
    },
    "SecurityGroupEgress": [
     {
      "IpProtocol": "-1",
      "CidrIp": "0.0.0.0/0",
      "Description": "Outbound TLS and AWS services; no public inbound"
     }
    ]
   }
  },
  "RedisSG": {
   "Type": "AWS::EC2::SecurityGroup",
   "Properties": {
    "GroupDescription": "EventClear Redis only",
    "VpcId": {
     "Ref": "Vpc"
    },
    "SecurityGroupEgress": [
     {
      "IpProtocol": "-1",
      "CidrIp": "0.0.0.0/0",
      "Description": "Outbound TLS and AWS services; no public inbound"
     }
    ]
   }
  },
  "AlbHttps": {
   "Type": "AWS::EC2::SecurityGroupIngress",
   "Properties": {
    "GroupId": {
     "Ref": "AlbSG"
    },
    "IpProtocol": "tcp",
    "FromPort": 443,
    "ToPort": 443,
    "CidrIp": "0.0.0.0/0"
   }
  },
  "WebFromAlb": {
   "Type": "AWS::EC2::SecurityGroupIngress",
   "Properties": {
    "GroupId": {
     "Ref": "WebSG"
    },
    "IpProtocol": "tcp",
    "FromPort": 3000,
    "ToPort": 3000,
    "SourceSecurityGroupId": {
     "Ref": "AlbSG"
    }
   }
  },
  "ApiFromAlb": {
   "Type": "AWS::EC2::SecurityGroupIngress",
   "Properties": {
    "GroupId": {
     "Ref": "ApiSG"
    },
    "IpProtocol": "tcp",
    "FromPort": 8000,
    "ToPort": 8000,
    "SourceSecurityGroupId": {
     "Ref": "AlbSG"
    }
   }
  },
  "ApiFromWeb": {
   "Type": "AWS::EC2::SecurityGroupIngress",
   "Properties": {
    "GroupId": {
     "Ref": "ApiSG"
    },
    "IpProtocol": "tcp",
    "FromPort": 8000,
    "ToPort": 8000,
    "SourceSecurityGroupId": {
     "Ref": "WebSG"
    }
   }
  },
  "SolverFromApi": {
   "Type": "AWS::EC2::SecurityGroupIngress",
   "Properties": {
    "GroupId": {
     "Ref": "SolverSG"
    },
    "IpProtocol": "tcp",
    "FromPort": 8001,
    "ToPort": 8001,
    "SourceSecurityGroupId": {
     "Ref": "ApiSG"
    }
   }
  },
  "DatabaseFromApi": {
   "Type": "AWS::EC2::SecurityGroupIngress",
   "Properties": {
    "GroupId": {
     "Ref": "DatabaseSG"
    },
    "IpProtocol": "tcp",
    "FromPort": 5432,
    "ToPort": 5432,
    "SourceSecurityGroupId": {
     "Ref": "ApiSG"
    }
   }
  },
  "DatabaseFromIndexer": {
   "Type": "AWS::EC2::SecurityGroupIngress",
   "Properties": {
    "GroupId": {
     "Ref": "DatabaseSG"
    },
    "IpProtocol": "tcp",
    "FromPort": 5432,
    "ToPort": 5432,
    "SourceSecurityGroupId": {
     "Ref": "IndexerSG"
    }
   }
  },
  "DatabaseFromMigration": {
   "Type": "AWS::EC2::SecurityGroupIngress",
   "Properties": {
    "GroupId": {
     "Ref": "DatabaseSG"
    },
    "IpProtocol": "tcp",
    "FromPort": 5432,
    "ToPort": 5432,
    "SourceSecurityGroupId": {
     "Ref": "MigrationSG"
    }
   }
  },
  "RedisFromApi": {
   "Type": "AWS::EC2::SecurityGroupIngress",
   "Properties": {
    "GroupId": {
     "Ref": "RedisSG"
    },
    "IpProtocol": "tcp",
    "FromPort": 6379,
    "ToPort": 6379,
    "SourceSecurityGroupId": {
     "Ref": "ApiSG"
    }
   }
  },
  "Certificate": {
   "Type": "AWS::CertificateManager::Certificate",
   "Properties": {
    "DomainName": {
     "Ref": "DomainName"
    },
    "ValidationMethod": "DNS",
    "DomainValidationOptions": [
     {
      "DomainName": {
       "Ref": "DomainName"
      },
      "HostedZoneId": {
       "Ref": "HostedZoneId"
      }
     }
    ]
   }
  },
  "Alb": {
   "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
   "Properties": {
    "Scheme": "internet-facing",
    "Subnets": [
     {
      "Ref": "PublicSubnet0"
     },
     {
      "Ref": "PublicSubnet1"
     }
    ],
    "SecurityGroups": [
     {
      "Ref": "AlbSG"
     }
    ],
    "LoadBalancerAttributes": [
     {
      "Key": "routing.http.drop_invalid_header_fields.enabled",
      "Value": "true"
     },
     {
      "Key": "routing.http.desync_mitigation_mode",
      "Value": "strictest"
     }
    ]
   }
  },
  "WebTarget": {
   "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
   "Properties": {
    "Port": 3000,
    "Protocol": "HTTP",
    "TargetType": "ip",
    "VpcId": {
     "Ref": "Vpc"
    },
    "HealthCheckPath": "/health",
    "Matcher": {
     "HttpCode": "200"
    }
   }
  },
  "ApiTarget": {
   "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
   "Properties": {
    "Port": 8000,
    "Protocol": "HTTP",
    "TargetType": "ip",
    "VpcId": {
     "Ref": "Vpc"
    },
    "HealthCheckPath": "/api/v1/health",
    "Matcher": {
     "HttpCode": "200"
    }
   }
  },
  "Https": {
   "Type": "AWS::ElasticLoadBalancingV2::Listener",
   "Properties": {
    "LoadBalancerArn": {
     "Ref": "Alb"
    },
    "Port": 443,
    "Protocol": "HTTPS",
    "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
    "Certificates": [
     {
      "CertificateArn": {
       "Ref": "Certificate"
      }
     }
    ],
    "DefaultActions": [
     {
      "Type": "forward",
      "TargetGroupArn": {
       "Ref": "WebTarget"
      }
     }
    ]
   }
  },
  "HealthRule": {
   "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
   "Properties": {
    "ListenerArn": {
     "Ref": "Https"
    },
    "Priority": 10,
    "Conditions": [
     {
      "Field": "path-pattern",
      "Values": [
       "/api/v1/health",
       "/api/v1/readiness"
      ]
     }
    ],
    "Actions": [
     {
      "Type": "forward",
      "TargetGroupArn": {
       "Ref": "ApiTarget"
      }
     }
    ]
   }
  },
  "Dns": {
   "Type": "AWS::Route53::RecordSet",
   "Properties": {
    "HostedZoneId": {
     "Ref": "HostedZoneId"
    },
    "Name": {
     "Ref": "DomainName"
    },
    "Type": "A",
    "AliasTarget": {
     "DNSName": {
      "Fn::GetAtt": [
       "Alb",
       "DNSName"
      ]
     },
     "HostedZoneId": {
      "Fn::GetAtt": [
       "Alb",
       "CanonicalHostedZoneID"
      ]
     }
    }
   }
  },
  "Cluster": {
   "Type": "AWS::ECS::Cluster",
   "Properties": {
    "ClusterName": {
     "Fn::Sub": "${AWS::StackName}"
    },
    "ClusterSettings": [
     {
      "Name": "containerInsights",
      "Value": "enabled"
     }
    ]
   }
  },
  "Namespace": {
   "Type": "AWS::ServiceDiscovery::PrivateDnsNamespace",
   "Properties": {
    "Name": "eventclear.internal",
    "Vpc": {
     "Ref": "Vpc"
    }
   }
  },
  "WebRepository": {
   "Type": "AWS::ECR::Repository",
   "Properties": {
    "RepositoryName": {
     "Fn::Sub": "${AWS::StackName}-web"
    },
    "ImageTagMutability": "IMMUTABLE",
    "ImageScanningConfiguration": {
     "ScanOnPush": true
    },
    "EncryptionConfiguration": {
     "EncryptionType": "AES256"
    },
    "LifecyclePolicy": {
     "LifecyclePolicyText": "{\"rules\": [{\"rulePriority\": 1, \"selection\": {\"tagStatus\": \"untagged\", \"countType\": \"sinceImagePushed\", \"countUnit\": \"days\", \"countNumber\": 7}, \"action\": {\"type\": \"expire\"}}]}"
    }
   }
  },
  "WebLogs": {
   "Type": "AWS::Logs::LogGroup",
   "Properties": {
    "LogGroupName": {
     "Fn::Sub": "/eventclear/${AWS::StackName}/web"
    },
    "RetentionInDays": 14
   }
  },
  "ApiRepository": {
   "Type": "AWS::ECR::Repository",
   "Properties": {
    "RepositoryName": {
     "Fn::Sub": "${AWS::StackName}-api"
    },
    "ImageTagMutability": "IMMUTABLE",
    "ImageScanningConfiguration": {
     "ScanOnPush": true
    },
    "EncryptionConfiguration": {
     "EncryptionType": "AES256"
    },
    "LifecyclePolicy": {
     "LifecyclePolicyText": "{\"rules\": [{\"rulePriority\": 1, \"selection\": {\"tagStatus\": \"untagged\", \"countType\": \"sinceImagePushed\", \"countUnit\": \"days\", \"countNumber\": 7}, \"action\": {\"type\": \"expire\"}}]}"
    }
   }
  },
  "ApiLogs": {
   "Type": "AWS::Logs::LogGroup",
   "Properties": {
    "LogGroupName": {
     "Fn::Sub": "/eventclear/${AWS::StackName}/api"
    },
    "RetentionInDays": 14
   }
  },
  "SolverRepository": {
   "Type": "AWS::ECR::Repository",
   "Properties": {
    "RepositoryName": {
     "Fn::Sub": "${AWS::StackName}-solver"
    },
    "ImageTagMutability": "IMMUTABLE",
    "ImageScanningConfiguration": {
     "ScanOnPush": true
    },
    "EncryptionConfiguration": {
     "EncryptionType": "AES256"
    },
    "LifecyclePolicy": {
     "LifecyclePolicyText": "{\"rules\": [{\"rulePriority\": 1, \"selection\": {\"tagStatus\": \"untagged\", \"countType\": \"sinceImagePushed\", \"countUnit\": \"days\", \"countNumber\": 7}, \"action\": {\"type\": \"expire\"}}]}"
    }
   }
  },
  "SolverLogs": {
   "Type": "AWS::Logs::LogGroup",
   "Properties": {
    "LogGroupName": {
     "Fn::Sub": "/eventclear/${AWS::StackName}/solver"
    },
    "RetentionInDays": 14
   }
  },
  "IndexerRepository": {
   "Type": "AWS::ECR::Repository",
   "Properties": {
    "RepositoryName": {
     "Fn::Sub": "${AWS::StackName}-indexer"
    },
    "ImageTagMutability": "IMMUTABLE",
    "ImageScanningConfiguration": {
     "ScanOnPush": true
    },
    "EncryptionConfiguration": {
     "EncryptionType": "AES256"
    },
    "LifecyclePolicy": {
     "LifecyclePolicyText": "{\"rules\": [{\"rulePriority\": 1, \"selection\": {\"tagStatus\": \"untagged\", \"countType\": \"sinceImagePushed\", \"countUnit\": \"days\", \"countNumber\": 7}, \"action\": {\"type\": \"expire\"}}]}"
    }
   }
  },
  "IndexerLogs": {
   "Type": "AWS::Logs::LogGroup",
   "Properties": {
    "LogGroupName": {
     "Fn::Sub": "/eventclear/${AWS::StackName}/indexer"
    },
    "RetentionInDays": 14
   }
  },
  "MigrationRepository": {
   "Type": "AWS::ECR::Repository",
   "Properties": {
    "RepositoryName": {
     "Fn::Sub": "${AWS::StackName}-migration"
    },
    "ImageTagMutability": "IMMUTABLE",
    "ImageScanningConfiguration": {
     "ScanOnPush": true
    },
    "EncryptionConfiguration": {
     "EncryptionType": "AES256"
    },
    "LifecyclePolicy": {
     "LifecyclePolicyText": "{\"rules\": [{\"rulePriority\": 1, \"selection\": {\"tagStatus\": \"untagged\", \"countType\": \"sinceImagePushed\", \"countUnit\": \"days\", \"countNumber\": 7}, \"action\": {\"type\": \"expire\"}}]}"
    }
   }
  },
  "MigrationLogs": {
   "Type": "AWS::Logs::LogGroup",
   "Properties": {
    "LogGroupName": {
     "Fn::Sub": "/eventclear/${AWS::StackName}/migration"
    },
    "RetentionInDays": 14
   }
  },
  "DbSubnet": {
   "Type": "AWS::RDS::DBSubnetGroup",
   "Properties": {
    "DBSubnetGroupDescription": "Private database",
    "SubnetIds": [
     {
      "Ref": "PrivateSubnet0"
     },
     {
      "Ref": "PrivateSubnet1"
     }
    ]
   }
  },
  "Database": {
   "Type": "AWS::RDS::DBInstance",
   "Properties": {
    "Engine": "postgres",
    "DBInstanceClass": {
     "Ref": "DbInstanceClass"
    },
    "AllocatedStorage": "20",
    "MaxAllocatedStorage": 50,
    "StorageType": "gp3",
    "StorageEncrypted": true,
    "DBName": "eventclear",
    "MasterUsername": "eventclear",
    "ManageMasterUserPassword": true,
    "PubliclyAccessible": false,
    "MultiAZ": false,
    "BackupRetentionPeriod": 7,
    "DBSubnetGroupName": {
     "Ref": "DbSubnet"
    },
    "VPCSecurityGroups": [
     {
      "Ref": "DatabaseSG"
     }
    ],
    "DeletionProtection": false,
    "EnableCloudwatchLogsExports": [
     "postgresql"
    ]
   },
   "DeletionPolicy": "Snapshot",
   "UpdateReplacePolicy": "Snapshot"
  },
  "RuntimeSecret": {
   "Type": "AWS::SecretsManager::Secret",
   "Properties": {
    "Name": {
     "Fn::Sub": "${AWS::StackName}-runtime"
    },
    "GenerateSecretString": {
     "SecretStringTemplate": "{}",
     "GenerateStringKey": "accessToken",
     "PasswordLength": 48,
     "ExcludePunctuation": true
    }
   }
  },
  "RedisAuth": {
   "Type": "AWS::SecretsManager::Secret",
   "Properties": {
    "Name": {
     "Fn::Sub": "${AWS::StackName}-redis"
    },
    "GenerateSecretString": {
     "PasswordLength": 48,
     "ExcludePunctuation": true
    }
   }
  },
  "RedisSubnet": {
   "Type": "AWS::ElastiCache::SubnetGroup",
   "Properties": {
    "Description": "Private cache",
    "SubnetIds": [
     {
      "Ref": "PrivateSubnet0"
     },
     {
      "Ref": "PrivateSubnet1"
     }
    ]
   }
  },
  "Redis": {
   "Type": "AWS::ElastiCache::ReplicationGroup",
   "Properties": {
    "ReplicationGroupDescription": "Controlled staging TLS authenticated cache",
    "Engine": "redis",
    "EngineVersion": "7.1",
    "CacheNodeType": {
     "Ref": "RedisNodeType"
    },
    "NumCacheClusters": 1,
    "AutomaticFailoverEnabled": false,
    "AtRestEncryptionEnabled": true,
    "TransitEncryptionEnabled": true,
    "AuthToken": {
     "Fn::Sub": "{{resolve:secretsmanager:${RedisAuth}:SecretString}}"
    },
    "CacheSubnetGroupName": {
     "Ref": "RedisSubnet"
    },
    "SecurityGroupIds": [
     {
      "Ref": "RedisSG"
     }
    ],
    "SnapshotRetentionLimit": 1
   }
  },
  "Artifacts": {
   "Type": "AWS::S3::Bucket",
   "Properties": {
    "VersioningConfiguration": {
     "Status": "Enabled"
    },
    "BucketEncryption": {
     "ServerSideEncryptionConfiguration": [
      {
       "ServerSideEncryptionByDefault": {
        "SSEAlgorithm": "AES256"
       }
      }
     ]
    },
    "PublicAccessBlockConfiguration": {
     "BlockPublicAcls": true,
     "IgnorePublicAcls": true,
     "BlockPublicPolicy": true,
     "RestrictPublicBuckets": true
    },
    "OwnershipControls": {
     "Rules": [
      {
       "ObjectOwnership": "BucketOwnerEnforced"
      }
     ]
    }
   },
   "DeletionPolicy": "Retain",
   "UpdateReplacePolicy": "Retain"
  },
  "ArtifactPolicy": {
   "Type": "AWS::S3::BucketPolicy",
   "Properties": {
    "Bucket": {
     "Ref": "Artifacts"
    },
    "PolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Deny",
       "Principal": "*",
       "Action": "s3:*",
       "Resource": [
        {
         "Fn::GetAtt": [
          "Artifacts",
          "Arn"
         ]
        },
        {
