  "TaskStoppedRule": {
   "Type": "AWS::Events::Rule",
   "Properties": {
    "EventPattern": {
     "source": [
      "aws.ecs"
     ],
     "detail-type": [
      "ECS Task State Change"
     ],
     "detail": {
      "clusterArn": [
       {
        "Fn::GetAtt": [
         "Cluster",
         "Arn"
        ]
       }
      ],
      "lastStatus": [
       "STOPPED"
      ],
      "containers": {
       "exitCode": [
        {
         "anything-but": 0
        }
       ]
      }
     }
    },
    "State": "ENABLED",
    "Targets": [
     {
      "Arn": {
