{
  "name": "eventclear",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "pnpm build && node --test tests/rendered-html.test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern build --ignore-pattern .next --ignore-pattern .wrangler --ignore-pattern test-results --ignore-pattern packages/contracts/lib --ignore-pattern packages/contracts/out --ignore-pattern .tools",
    "typecheck": "tsc --noEmit",
    "contracts:verify-manifest": "tsx scripts/verify-manifest.ts",
    "contracts:check-api-abi": "python scripts/check_api_abi.py",
    "security:dependencies": "node scripts/check-dependencies.mjs",
    "security:licenses": "node scripts/check-licenses.mjs",
    "deployment:sync-local": "tsx scripts/sync-local-deployment.ts",
    "deployment:record-staging": "tsx scripts/record-staging-deployment.ts",
    "staging:preflight": "node scripts/staging-external-preflight.mjs",
    "db:generate": "drizzle-kit generate",
    "indexer:run": "pnpm --dir apps/indexer run",
    "indexer:backfill": "pnpm --dir apps/indexer backfill",
    "indexer:reconcile": "pnpm --dir apps/indexer reconcile",
    "indexer:status": "pnpm --dir apps/indexer status",
    "indexer:test": "pnpm --dir apps/indexer test"
  },
  "dependencies": {
    "@polymarket/client": "0.2.0",
    "@tanstack/react-query": "^5.83.0",
    "drizzle-orm": "0.45.2",
    "lightweight-charts": "^5.0.8",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.61.1",
    "viem": "^2.33.2",
    "wagmi": "^2.16.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "turbo": "^2.5.5",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "type": "module"
}
