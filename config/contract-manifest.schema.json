{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventClear contract manifest",
  "type": "object",
  "required": ["chainId", "reviewedAt", "contracts"],
  "properties": {
    "chainId": { "type": "integer" },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "string" },
    "contracts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["address"],
        "properties": {
          "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "expectedInterface": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
